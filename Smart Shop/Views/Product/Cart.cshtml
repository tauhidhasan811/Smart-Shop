
@{
    ViewBag.Title = "Cart";
}

<h2>Cart</h2>

<table>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Quantity</th>
        <th>Price</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Quantity</td>
            <td>@item.Price</td>
        </tr>

    }
</table>




